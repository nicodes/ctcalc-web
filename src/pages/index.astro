---
import Full from '../layouts/Full.astro';

const appUrl = 'https://app.ctcalc.com';

// The reading shown in the frame is a real one. Free chlorine against giardia
// at 5 °C, 1.0 mg/L, pH 7.0, for 2-log inactivation is 99 mg·min/L in the
// manual's table, and the regression published alongside it gives 107 for the
// same conditions. Both are what the app returns, formatted the way the app
// formats them — see README.
const example = {
	temperature: '5',
	residual: '1.0',
	ph: '7.0',
	logs: '2',
	table: '99.0',
	formula: '107',
};

const coverage = [
	{ disinfectant: 'Free chlorine', from: '0.5 °C', chemistry: 'Temperature, residual and pH' },
	{ disinfectant: 'Chloramine', from: '1 °C', chemistry: 'Temperature' },
	{ disinfectant: 'Chlorine dioxide', from: '1 °C', chemistry: 'Temperature' },
	{ disinfectant: 'Ozone', from: '1 °C', chemistry: 'Temperature' },
];
---

<Full>
	<div class="folio">
		<header class="topbar">
			<a class="wordmark" href="/">
				CT Calc
			</a>
			<nav aria-label="Main">
				<a href="#coverage">Coverage</a>
				<a href="https://app.ctcalc.com">Open calculator ↗</a>
			</nav>
		</header>
		<main id="main-content">
			<section class="calc-cover">
				<div class="calc-copy">
					<p class="tag">WATER TREATMENT / A POCKET REFERENCE</p>
					<h1>
						The right CT.
						<br />
						<em>
							Right where
							<br />
							you need it.
						</em>
					</h1>
					<p>
						Disinfection calculations from the EPA’s published tables. Enter the conditions and get a reading, even when
						you’re offline.
					</p>
					<a class="cta" href={appUrl}>
						Open CT Calc <span>↗</span>
					</a>
					<p class="source-label">FOUR DISINFECTANTS · GIARDIA & VIRUSES</p>
				</div>
				<div class="reading-card">
					<div class="reading-header">
						<span>FIELD NOTE / WORKED EXAMPLE</span>
						<svg viewBox="0 0 32 40" width="32" height="40" aria-hidden="true">
							<path d="M16 2C13 8 3 17 3 25a13 13 0 0 0 26 0C29 17 19 8 16 2Z" fill="#278c9b" />
						</svg>
					</div>
					<p class="reading-title">Free chlorine → Giardia</p>
					<dl class="conditions">
						<div>
							<dt>Temperature</dt>
							<dd>{example.temperature} °C</dd>
						</div>
						<div>
							<dt>Residual</dt>
							<dd>{example.residual} mg/L</dd>
						</div>
						<div>
							<dt>pH</dt>
							<dd>{example.ph}</dd>
						</div>
						<div>
							<dt>Inactivation</dt>
							<dd>{example.logs}-log</dd>
						</div>
					</dl>
					<div class="reading-result">
						<span>CT REQUIRED / TABLE INTERPOLATION</span>
						<b>{example.table}</b>
						<small>mg·min/L</small>
					</div>
					<p class="regression">
						The manual’s regression gives <strong>{example.formula} mg·min/L</strong> for the same conditions.
					</p>
					<div class="reading-footer">
						EPA 815-R-99-013 <span>REFERENCE EXAMPLE</span>
					</div>
				</div>
			</section>
			<section class="reference-strip">
				<span>EPA TABLES</span>
				<i>→</i>
				<span>YOUR CONDITIONS</span>
				<i>→</i>
				<span>INTERPOLATED CT</span>
			</section>
			<section class="card-grid">
				<article>
					<p class="tag">01 / AT THE PLANT</p>
					<h3>No signal required.</h3>
					<p>The tables and calculations live on your device. Open the app once, then keep the reference close.</p>
				</article>
				<article>
					<p class="tag">02 / BETWEEN ROWS</p>
					<h3>Read between the values.</h3>
					<p>Interpolation across temperature, and across residual and pH for free chlorine against Giardia.</p>
				</article>
				<article>
					<p class="tag">03 / DEFINED LIMITS</p>
					<h3>The range stays explicit.</h3>
					<p>Conditions outside the published tables are refused. Cryptosporidium is not covered.</p>
				</article>
			</section>
			<section class="coverage" id="coverage">
				<div class="coverage-copy">
					<h2>What it covers</h2>
					<p>
						Giardia from 0.5-log to 3-log inactivation in half-log steps, and viruses at 2-log, 3-log and 4-log — to
						25&nbsp;°C, for every disinfectant the manual tabulates. Cryptosporidium is not covered.
					</p>
				</div>
				<table>
					<thead>
						<tr>
							<th scope="col">Disinfectant</th>
							<th scope="col">From</th>
							<th scope="col">Varies over</th>
						</tr>
					</thead>
					<tbody>
						{coverage.map((row) => (
							<tr>
								<th scope="row">{row.disinfectant}</th>
								<td>{row.from}</td>
								<td>{row.chemistry}</td>
							</tr>
						))}
					</tbody>
				</table>
			</section>
			<section class="calc-close">
				<p class="tag">READY WHEN YOU ARE</p>
				<h2 class="section-heading">
					A reference you can
					<br />
					take into the plant room.
				</h2>
				<a class="cta" href={appUrl}>
					Open the calculator ↗
				</a>
			</section>
		</main>
		<footer class="bottom">
			<span>CT Calc / EPA 815-R-99-013</span>
			<nav aria-label="Footer">
				<a href="https://app.ctcalc.com">Open calculator</a>
			</nav>
		</footer>
	</div>
</Full>
<style>
	* {
		box-sizing: border-box;
	}
	a {
		color: inherit;
		text-underline-offset: 5px;
	}
	img {
		max-width: 100%;
	}
	svg {
		max-width: 100%;
	}
	h1,
	h2,
	h3,
	p {
		overflow-wrap: break-word;
	}
	h1,
	h2,
	h3 {
		text-wrap: balance;
	}
	p {
		line-height: 1.7;
	}
	code,
	pre {
		font-family: var(--mono);
	}
	pre {
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
	.folio {
		width: min(1200px, calc(100% - 64px));
		margin: auto;
	}
	.topbar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 24px;
		min-height: 100px;
	}
	.wordmark {
		font-size: 23px;
		font-weight: 750;
		letter-spacing: -0.04em;
		text-decoration: none;
	}
	.topbar nav {
		display: flex;
		gap: 25px;
		align-items: center;
		font-size: 12px;
	}
	.topbar nav a {
		text-decoration: none;
	}
	.tag {
		font: 11px var(--mono);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.cta {
		display: inline-flex;
		align-items: center;
		justify-content: space-between;
		gap: 30px;
		padding: 18px 25px;
		font-size: 14px;
		font-weight: 650;
		text-decoration: none;
		border-radius: 4px;
	}
	.bottom {
		padding: 35px 0;
		display: flex;
		justify-content: space-between;
		gap: 20px;
		align-items: center;
		font-size: 12px;
		border-top: 1px solid var(--line);
	}
	.bottom nav {
		display: flex;
		gap: 20px;
	}
	.section-heading {
		font-size: clamp(32px, 4vw, 52px);
		letter-spacing: -0.04em;
		font-weight: 550;
		line-height: 1.1;
	}
	.card-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 25px;
	}
	.card-grid h3 {
		font-size: 22px;
		font-weight: 600;
		letter-spacing: -0.025em;
	}
	.card-grid p {
		font-size: 14px;
	}
	.icon svg {
		width: 16px;
		height: 16px;
		fill: currentColor;
	}
	details summary {
		cursor: pointer;
		padding: 20px 0;
		font-size: 16px;
	}
	details {
		border-top: 1px solid var(--line);
	}
	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 13px;
	}
	th,
	td {
		text-align: left;
		padding: 15px;
		border-bottom: 1px solid var(--line);
		overflow-wrap: anywhere;
	}
	th {
		font-weight: 600;
	}
	main > section {
		margin-bottom: 100px;
	}
	.source-label {
		font: 10px var(--mono);
		letter-spacing: 0.06em;
	}
	a:focus-visible,
	summary:focus-visible {
		outline: 3px solid currentColor;
		outline-offset: 5px;
	}
	@media (max-width: 900px) {
		.card-grid {
			grid-template-columns: 1fr;
		}
		main > section {
			margin-bottom: 70px;
		}
	}
	@media (max-width: 600px) {
		.folio {
			width: calc(100% - 36px);
		}
		.topbar {
			min-height: 85px;
			gap: 16px;
			flex-wrap: wrap;
			padding: 20px 0;
		}
		.topbar nav {
			gap: 16px;
			font-size: 11px;
		}
		.wordmark {
			font-size: 21px;
		}
		.bottom {
			flex-wrap: wrap;
		}
		.cta {
			padding: 16px 20px;
		}
		th,
		td {
			padding: 12px 7px;
			font-size: 11px;
		}
		main > section {
			margin-bottom: 55px;
		}
	}
	.calc-cover {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 90px;
		align-items: center;
		padding-top: 45px;
	}
	.calc-copy h1 {
		font-size: clamp(52px, 6.2vw, 84px);
		line-height: 1.03;
		letter-spacing: -0.055em;
		margin: 30px 0;
		font-weight: 550;
	}
	.calc-copy h1 em {
		font-family: var(--sans);
		font-style: normal;
		font-weight: 550;
		color: #28717c;
	}
	.calc-copy > p:not(.tag):not(.source-label) {
		font-size: 18px;
		max-width: 440px;
		color: #527079;
	}
	.cta {
		background: #195763;
		color: white;
	}
	.source-label {
		margin-top: 25px;
		color: #527079;
	}
	.reading-card {
		position: relative;
		background: #fff;
		border: 1px solid #cfdee1;
		border-radius: 6px;
		padding: 32px;
		box-shadow: 12px 16px 0 #dbe7e8;
	}
	.reading-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		font: 10px var(--mono);
		color: #527079;
	}
	.reading-title {
		font-size: 22px;
		font-weight: 600;
	}
	.conditions {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0;
		margin: 25px 0;
	}
	.conditions > div {
		padding: 18px 0;
		border-top: 1px solid #dde7e9;
	}
	.conditions dt {
		font-size: 11px;
		color: #6b858c;
		margin-bottom: 8px;
	}
	.conditions dd {
		margin: 0;
		font: 21px var(--mono);
	}
	.reading-result {
		background: #e7f2f1;
		padding: 25px;
		border-left: 3px solid #278c9b;
	}
	.reading-result > span {
		font: 9px var(--mono);
		display: block;
		letter-spacing: 0.05em;
	}
	.reading-result b {
		display: block;
		font-size: 92px;
		line-height: 1.2;
		letter-spacing: -0.06em;
		font-weight: 500;
	}
	.reading-result small {
		font: 13px var(--mono);
		color: #28717c;
	}
	.regression {
		font-size: 12px;
		color: #527079;
	}
	.reading-footer {
		display: flex;
		justify-content: space-between;
		gap: 15px;
		padding-top: 20px;
		border-top: 1px solid #dde7e9;
		font: 9px var(--mono);
		color: #527079;
	}
	.reference-strip {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 28px 40px;
		background: #153641;
		color: #dfeef0;
		font: 12px var(--mono);
		gap: 15px;
	}
	.reference-strip i {
		font-style: normal;
		color: #7cbdc4;
	}
	.card-grid article {
		padding: 20px 0;
		border-top: 1px solid var(--line);
	}
	.card-grid .tag {
		color: #28717c;
	}
	.card-grid p:last-child {
		color: #527079;
	}
	.coverage {
		display: grid;
		grid-template-columns: 1fr 1.4fr;
		gap: 55px;
		padding-top: 45px;
		border-top: 1px solid var(--line);
	}
	.coverage h2 {
		font-size: 36px;
		font-weight: 500;
		letter-spacing: -0.04em;
	}
	.coverage p {
		font-size: 14px;
		color: #527079;
	}
	.coverage table {
		background: #fff;
	}
	.calc-close {
		background: #dfeeed;
		padding: 45px;
	}
	.calc-close h2 {
		margin: 25px 0 30px;
	}
	@media (max-width: 900px) {
		.calc-cover {
			gap: 35px;
		}
		.coverage {
			grid-template-columns: 1fr;
			gap: 25px;
		}
		.reading-card {
			padding: 25px;
		}
		.reference-strip {
			font-size: 10px;
			padding: 25px;
		}
	}
	@media (max-width: 600px) {
		.calc-cover {
			grid-template-columns: 1fr;
			padding-top: 20px;
			gap: 35px;
		}
		.calc-copy h1 {
			font-size: 55px;
		}
		.calc-copy > p:not(.tag):not(.source-label) {
			font-size: 16px;
		}
		.reading-card {
			padding: 22px;
			box-shadow: 6px 8px 0 #dbe7e8;
		}
		.reading-result b {
			font-size: 80px;
		}
		.reading-title {
			font-size: 20px;
		}
		.reference-strip {
			flex-direction: column;
			align-items: start;
			padding: 25px;
		}
		.reference-strip i {
			transform: rotate(90deg);
		}
		.calc-close {
			padding: 30px 24px;
		}
		.reading-footer {
			font-size: 8px;
		}
	}
</style>
